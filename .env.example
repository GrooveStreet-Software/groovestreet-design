# Copy to .env.local for `yarn dev` / `yarn build`. All values are optional.

# Public address of the site (no trailing slash), used for the canonical link
# and the social preview cards. Defaults to http://localhost:3030.
# Set this to the final custom domain before the production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Google Search Console HTML tag verification token. Optional: DNS verification
# works too and needs no rebuild. Set this before building to emit the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Free. Leave blank to disable
# analytics entirely. The script only loads after the visitor accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Base URL of an external API that receives the contact form (no trailing slash).
# Leave empty to use the built-in /api/contact endpoint instead.
NEXT_PUBLIC_API_BASE_URL=

# --- Contact form email (free tier) -------------------------------------------
# The contact form posts to /api/contact, which forwards the message to
# Web3Forms. Their free plan needs nothing but this access key — no server, no
# paid tier. Get one at https://web3forms.com (it takes about a minute and the
# key decides which inbox receives the mail).
#
# Without this key the form still validates and shows a clear message, but
# nothing is delivered.
CONTACT_ACCESS_KEY=
